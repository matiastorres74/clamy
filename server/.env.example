# Pooled connection (runtime queries) and direct connection (migrations) —
# Vercel Postgres/Neon populate both automatically once the store is
# connected to the project (as POSTGRES_PRISMA_URL / POSTGRES_URL_NON_POOLING).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
JWT_SECRET="change-this-to-a-long-random-string"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"
PORT=3001
CORS_ORIGIN="http://localhost:4200"
# Injected automatically by Vercel once a Blob store is connected to the
# project; required locally too since uploads now go straight to Blob.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# Injected automatically once a KV/Upstash Redis store is connected to the
# project — used to rate-limit admin login attempts across serverless
# invocations. Without these, login rate limiting is disabled (a warning is
# logged on startup) rather than silently unenforced.
UPSTASH_REDIS_REST_URL="https://your-store.upstash.io"
UPSTASH_REDIS_REST_TOKEN="..."
